<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Android has refused cleartext HTTP since API 28, and the
  API this app is developed against runs on a Mac over plain HTTP — the
  emulator reaches it at 10.0.2.2, which is the host's loopback seen from
  inside the VM.

  This is the Android half of the `NSAppTransportSecurity` block in
  `ios/Fishers/Resources/Info.plist`: the same exception, for the same reason,
  scoped the same way. Release builds do not include this file and keep
  cleartext refused, so a TestFlight-equivalent build cannot be pointed at an
  http:// server by accident.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The host, from inside the emulator. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- A device on the same Wi-Fi as the Mac running scripts/start.sh,
             which prints the LAN address it bound to. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
