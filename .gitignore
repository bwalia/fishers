# Rust
backend/target/
**/*.rs.bk
# Cargo.lock is committed: the workspace ships a binary, and a pinned graph is
# what keeps `cargo run -p fishers-api` reproducible across toolchains.

# iOS / Xcode
ios/Fishers.xcodeproj/
ios/Fishers.xcworkspace/
ios/DerivedData/
ios/build/
ios/.ios-secrets/
ios/.bundle/
ios/vendor/bundle/
ios/**/*.xcuserstate
ios/**/xcuserdata/
ios/**/*.xccheckout
ios/**/*.moved-aside
ios/**/*.hmap
ios/**/*.ipa
ios/**/*.dSYM.zip
ios/**/*.dSYM
ios/.build/
*.playground
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/
docs/screenshots/

# Env & secrets
.env
.env.local
# A backup of .env holds the same secrets it does. One was very nearly
# committed after being made before an edit.
.env.bak*
.env.*.bak
*.pem
*.p8
Secrets.xcconfig

