.dev/

# Generated by tools/brand from brands/<id>.yaml. Not committed: generated code
# in the repo drifts from the source it came from, and the brand is the source.
web/src/brand.generated.ts
web/src/app/brand.generated.css
android/app/src/*/res/values/brand_colors.xml
ios/Fishers/Brand/Generated/
tools/brand/node_modules/
