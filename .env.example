# Copy to .env and adjust as needed
# Host port Postgres binds to — change both of these together.
# 7313/7312/7311 are deliberately off the beaten track so the stack does not
# fight Postgres on 5432/5433, or another dev server on 3000/8080.
POSTGRES_PORT=7313
DATABASE_URL=postgres://fishers:fishers@localhost:7313/fishers
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=2592000
API_HOST=0.0.0.0
API_PORT=7312
RUST_LOG=fishers_api=debug,tower_http=info,sqlx=warn

# Chat assistant. Without a key the agent endpoints return status "disabled"
# and the rest of chat works normally.
ANTHROPIC_API_KEY=
# Override to pin a different model, or point at a gateway/proxy.
FISHERS_AGENT_MODEL=claude-opus-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# Email: verification codes, reconfirmations, fee reminders. Unset means email
# is off — and so is the "confirm your email" requirement, since a code that
# can never arrive would lock everyone out.
#
#   Local, with the Mailpit in docker-compose (read mail at localhost:8025):
#     SMTP_HOST=mailpit   (API in Docker)  or  localhost  (API from local cargo)
#     SMTP_PORT=1025
#     SMTP_TLS=none
#
#   Gmail: an *app password* (Google account > Security > App passwords), not
#   the account password, which Gmail refuses over SMTP.
#     SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_TLS=starttls
#     SMTP_USERNAME=you@gmail.com  SMTP_PASSWORD=<16-character app password>
SMTP_HOST=
# EMAIL_FROM="Fishers <you@gmail.com>"

# Require a confirmed email or phone before someone can start a club or accept
# an invite. Off by default: turn on once the codes are ready to rely on.
# Configuring SMTP alone does not turn this on.
VERIFICATION_REQUIRED=false

# Phone verification over WhatsApp — Meta's official Cloud API, not an
# unofficial gateway. Unset means phone verification is off.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=fishers_verification
# WHATSAPP_TEMPLATE_LANG=en_GB

# Stripe (phase 4)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# APNs (phase 3)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.fishers.app

# Public web origin used when minting live scoreboard share links, and the
# origins the browser is allowed to call the API from. The iOS app does not use
# CORS; the Next.js dashboard in web/ does.
#
# scripts/start.sh sets both from this Mac's current LAN address, so these two
# only matter when running the API by hand. A LAN IP written down here goes
# stale on the next DHCP lease and the symptom is a dashboard that cannot sign
# in — leave them on loopback unless you know you need otherwise.
PUBLIC_WEB_BASE=http://127.0.0.1:7311
CORS_ALLOWED_ORIGINS=http://127.0.0.1:7311,http://localhost:7311

# Duckworth-Lewis. The built-in resource table is a documented approximation of
# the Standard Edition; point this at a CSV of `overs,w0,w1,...,w9` rows to use
# a licensed table instead. DLS_G50 defaults to 245.
DLS_RESOURCE_TABLE=
DLS_G50=245

# Ball-by-ball commentary from an Ollama model. Unset, every ball keeps the
# line the app writes from the log; set, that line is enriched afterwards —
# never before, because a scorer will not wait on a model to record a ball.
# e.g. http://127.0.0.1:11434 for a local one, or your own host.
OLLAMA_URL=
OLLAMA_MODEL=llama3.1:8b
