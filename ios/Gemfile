source "https://rubygems.org"

# fastlane drives signing (cert + sigh), TestFlight upload, and App Store
# submission. See fastlane/Fastfile and .github/workflows/ios_release.yml.
#
# Requires Bundler 2.x (Ruby 3.2+ removed String#untaint; Bundler 1.17 breaks).
#
# Homebrew Ruby 4.x no longer ships ostruct/logger/etc as default gems; fastlane
# still requires them — pin explicitly so `bundle exec fastlane` loads.
gem "fastlane", "~> 2.240"
gem "ostruct"
gem "logger"
gem "csv"
gem "base64"
gem "mutex_m"
gem "abbrev"
gem "nkf"
gem "rexml"
