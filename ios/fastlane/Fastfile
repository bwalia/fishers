# Fastfile — Fishers native iOS release (GitHub Actions + Vault + fastlane).
#
# CI signs with an App Store Connect API key. Secrets come from GitHub Actions
# or Vault via ci/load-ios-vault-secrets.sh, then:
#   ci_build_number → prepare_signing → build_ipa → beta (TestFlight)
# See .github/workflows/ios_release.yml and docs/IOS_RELEASE.md.

default_platform(:ios)

APP_ID = "com.fishers.app".freeze

# Every main merge makes these emails internal testers on "Fishers Team" —
# App Store Connect team members, so builds install with no Beta App Review.
# Anyone who has not yet accepted the team invite is also kept on the external
# group "Fishers", whose review is left to finish rather than cancelled.
# Override with TESTFLIGHT_GROUP / TESTFLIGHT_TESTERS (comma-separated).
DEFAULT_TESTFLIGHT_GROUP = "Fishers".freeze
DEFAULT_TESTFLIGHT_TESTERS = [
  "balindersinghwalia@icloud.com",
  "harchran001@gmail.com"
].freeze

def team_id
  ENV.fetch("APPLE_TEAM_ID") do
    UI.user_error!("APPLE_TEAM_ID is not set — add it to WSLVault kv/fishers/ios or GitHub secrets")
  end
end

def asc_api_key
  # duration 500 avoids a known Spaceship JWT skew issue where duration:1200
  # (default max) is rejected by App Store Connect as an invalid bearer token.
  # See fastlane/fastlane#29468 / #21109.
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID").to_s.strip,
    issuer_id: ENV.fetch("ASC_ISSUER_ID").to_s.strip,
    key_filepath: ENV.fetch("ASC_KEY_FILEPATH").to_s.strip,
    duration: 500,
    in_house: false
  )
end

# Write Vault / env Google OAuth ids into project.yml just before xcodegen so
# Info.plist gets the URL scheme without committing client ids to git.
def inject_google_oauth_client_ids!
  ios_id = ENV["GOOGLE_IOS_CLIENT_ID"].to_s.strip
  reversed = ENV["GOOGLE_REVERSED_CLIENT_ID"].to_s.strip
  path = File.expand_path("../project.yml", __dir__)
  text = File.read(path)
  if ios_id.empty? && reversed.empty?
    UI.message("GOOGLE_IOS_CLIENT_ID / GOOGLE_REVERSED_CLIENT_ID unset — Google URL scheme left blank")
    return
  end
  text = text.sub(/GOOGLE_IOS_CLIENT_ID:\s*"[^"]*"/, "GOOGLE_IOS_CLIENT_ID: \"#{ios_id}\"")
  text = text.sub(/GOOGLE_REVERSED_CLIENT_ID:\s*"[^"]*"/, "GOOGLE_REVERSED_CLIENT_ID: \"#{reversed}\"")
  File.write(path, text)
  UI.success("Injected Google OAuth client ids into project.yml for this build")
end

def generate_xcode_project!
  inject_google_oauth_client_ids!
  sh("xcodegen", "generate", "--spec", "../project.yml")
end

# App ID must include Sign in with Apple or the App Store profile refuses the
# entitlement in Fishers.entitlements. Enable it via the Developer API when
# missing, then sigh regenerates the profile with force: true.
def ensure_sign_in_with_apple_capability!(api_key)
  spaceship_token_from!(api_key)
  ids = Spaceship::ConnectAPI.get_bundle_ids(
    filter: { identifier: APP_ID },
    includes: "bundleIdCapabilities"
  )
  models = ids.respond_to?(:all_pages) ? ids.all_pages.flat_map(&:to_models) : Array(ids)
  bundle = models.find { |b| b.identifier.to_s == APP_ID } || models.first
  UI.user_error!("Developer App ID '#{APP_ID}' not found — create it in the Apple Developer portal") unless bundle

  caps = Array(bundle.bundle_id_capabilities)
  type = Spaceship::ConnectAPI::BundleIdCapability::Type::APPLE_ID_AUTH
  already = caps.any? do |c|
    t = c.respond_to?(:capability_type) ? c.capability_type : c["capabilityType"]
    t.to_s == type.to_s || t.to_s == "APPLE_ID_AUTH"
  end
  if already
    UI.message("Sign in with Apple already enabled on #{APP_ID}")
    return
  end

  UI.important("Enabling Sign in with Apple on App ID #{APP_ID}")
  # Apple requires a consent configuration — PRIMARY_APP_CONSENT for the main app.
  consent = Spaceship::ConnectAPI::BundleIdCapability::Settings::APPLE_ID_AUTH_APP_CONSENT rescue "APPLE_ID_AUTH_APP_CONSENT"
  primary = Spaceship::ConnectAPI::BundleIdCapability::Options::PRIMARY_APP_CONSENT rescue "PRIMARY_APP_CONSENT"
  Spaceship::ConnectAPI::BundleIdCapability.create(
    bundle_id_id: bundle.id,
    capability_type: type,
    settings: [{
      key: consent,
      options: [{ key: primary }]
    }]
  )
  UI.success("Sign in with Apple enabled on #{APP_ID}")
rescue => e
  UI.user_error!(
    "Could not enable Sign in with Apple on #{APP_ID}: #{e.message}. " \
    "Enable it once at https://developer.apple.com/account/resources/identifiers/list " \
    "then re-run iOS Release."
  )
end

def testflight_group_name
  ENV.fetch("TESTFLIGHT_GROUP", DEFAULT_TESTFLIGHT_GROUP).to_s.strip
end

def testflight_tester_emails
  raw = ENV["TESTFLIGHT_TESTERS"].to_s.strip
  list = if raw.empty?
           DEFAULT_TESTFLIGHT_TESTERS
         else
           raw.split(/[,\s]+/).map(&:strip).reject(&:empty?)
         end
  list.map(&:downcase).uniq
end

INTERNAL_TESTFLIGHT_GROUP = "Fishers Team".freeze
FISHERS_PUBLIC_LINK = "https://testflight.apple.com/join/YXCcSAPj".freeze

# Apple's "build has completed processing" mail goes to the *developer* ASC
# account — it is NOT the TestFlight install invite. The install invite is a
# separate TestFlight email ("You're invited to test …").
def fishers_app!
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  UI.user_error!("App Store Connect app '#{APP_ID}' not found — create it first") unless app
  app
end

def beta_testers_for_app_email(app:, email:)
  Array(
    Spaceship::ConnectAPI.get_beta_testers(
      filter: { email: email, apps: app.id },
      includes: "betaGroups"
    ).all_pages
  ).flat_map(&:to_models).uniq { |t| t.id }
rescue => e
  UI.message("get_beta_testers(#{email}): #{e.message}")
  tester = Spaceship::ConnectAPI::BetaTester.find(email: email) rescue nil
  tester ? [tester] : []
end

def tester_state_label(tester)
  return "unknown" unless tester
  if tester.respond_to?(:beta_tester_state) && !tester.beta_tester_state.to_s.empty?
    tester.beta_tester_state.to_s
  elsif tester.respond_to?(:invite_type)
    tester.invite_type.to_s
  else
    "unknown"
  end
end

def send_testflight_invitation!(app:, email:)
  tester = beta_testers_for_app_email(app: app, email: email).first
  unless tester&.id
    UI.important("No beta tester record for #{email} — cannot call betaTesterInvitations")
    return false
  end

  state = tester_state_label(tester)
  UI.message("#{email} betaTesterState=#{state}")

  body = {
    data: {
      type: "betaTesterInvitations",
      relationships: {
        app: { data: { type: "apps", id: app.id } },
        betaTester: { data: { type: "betaTesters", id: tester.id } }
      }
    }
  }

  client = Spaceship::ConnectAPI.client
  UI.user_error!("Spaceship ConnectAPI client missing — token not set") unless client
  client.test_flight_request_client.post("v1/betaTesterInvitations", body)
  UI.success(
    "Apple accepted betaTesterInvitations for #{email} — " \
    "look for \"You're invited to test Fishers Sport\" (NOT processing-complete mail)"
  )
  true
rescue => e
  msg = e.message.to_s
  if msg =~ /already|accepted|cannot|not eligible|ENTITY/i
    UI.message("betaTesterInvitations for #{email}: #{msg} (tester may already be Accepted — open TestFlight app or use public link)")
  else
    UI.important("betaTesterInvitations for #{email} failed: #{msg}")
  end
  false
end

def assign_tester_to_fishers_group!(group:, email:)
  Spaceship::ConnectAPI.post_beta_tester_assignment(
    beta_group_ids: [group.id],
    attributes: {
      email: email,
      firstName: email.split("@").first.to_s[0, 30],
      lastName: "Tester"
    }
  )
  UI.success("Assigned #{email} to TestFlight group '#{group.name}'")
  true
rescue => e
  msg = e.message.to_s
  if msg =~ /already|exists|conflict|cannot be assigned|ENTITY_ERROR/i
    UI.message("#{email} already assigned to '#{group.name}'")
    true
  else
    UI.important("Assign #{email} to '#{group.name}': #{msg}")
    false
  end
end

# External group only: add the tester without purging first. Purging on every
# run deleted the tester from the app — internal group included — and reset
# whatever invite Apple had already sent.
def invite_tester_to_fishers!(app:, group:, email:)
  assign_tester_to_fishers_group!(group: group, email: email)
  sleep(2)
  send_testflight_invitation!(app: app, email: email)
end

# Only internal testers skip Beta App Review, and Apple only lets App Store
# Connect team members be internal testers. So each tester is invited to the
# team first — Marketing role, the least privilege that still counts as
# internal, limited to this app, no certificates access. Creating a user
# invitation needs an Admin API key.
ASC_TESTER_ROLE = "MARKETING".freeze

def asc_team_member_state!(app:, email:)
  member = Array(Spaceship::ConnectAPI::User.all).find do |u|
    [u.username, u.email].compact.map { |s| s.to_s.downcase }.include?(email)
  end
  return :member if member

  pending = Array(Spaceship::ConnectAPI::UserInvitation.all).find { |i| i.email.to_s.downcase == email }
  return :invited if pending

  local = email.split("@").first.to_s.gsub(/[^A-Za-z0-9]/, " ").strip
  Spaceship::ConnectAPI::UserInvitation.create(
    email: email,
    first_name: (local.empty? ? "Fishers" : local)[0, 30],
    last_name: "Tester",
    roles: [ASC_TESTER_ROLE],
    provisioning_allowed: false,
    all_apps_visible: false,
    visible_app_ids: [app.id]
  )
  UI.success("Invited #{email} to the App Store Connect team (#{ASC_TESTER_ROLE}, Fishers only)")
  :invited
rescue => e
  UI.important("App Store Connect team invite for #{email} failed: #{e.message} " \
               "(the API key needs the Admin role to invite users)")
  :failed
end

# Internal "Fishers Team" has access to every build, so a member added here can
# install straight away from the TestFlight app — no review, no build attach.
def add_internal_tester!(app:, group:, email:)
  state = asc_team_member_state!(app: app, email: email)
  case state
  when :member
    assign_tester_to_fishers_group!(group: group, email: email)
    sleep(2)
    send_testflight_invitation!(app: app, email: email)
    UI.success("#{email}: internal tester on '#{group.name}' — installs from TestFlight without review")
  when :invited
    UI.important("#{email}: must accept the App Store Connect team email (\"You've been invited to App Store Connect\"), " \
                 "then re-run the iOS Release workflow with target invite_testers")
  end
  state
end

def ensure_internal_testers!(app:)
  group = ensure_fishers_internal_group!(app: app)
  testflight_tester_emails.to_h { |email| [email, add_internal_tester!(app: app, group: group, email: email)] }
end

def report_tester_states(states)
  states.each { |email, state| UI.message("  #{email}: #{state}") }
  emit_github("GITHUB_STEP_SUMMARY", "### TestFlight testers")
  states.each do |email, state|
    note = { member: "internal tester — install from TestFlight now (no review)",
             invited: "App Store Connect team invite pending — accept the email, then re-run invite_testers",
             failed: "team invite failed — see log" }[state]
    emit_github("GITHUB_STEP_SUMMARY", "- #{email}: #{note}")
  end
end

# Enable a public join link on Fishers so testers can open TestFlight without
# hunting for the invite email (still requires Beta App Review for the first build).
def ensure_fishers_public_link!(group:)
  attrs = { publicLinkEnabled: true, publicLinkLimitEnabled: false, publicLinkLimit: 10_000 }
  begin
    Spaceship::ConnectAPI.patch_group(group_id: group.id, attributes: attrs)
  rescue => e
    UI.message("patch_group public link: #{e.message}")
  end

  refreshed =
    begin
      Array(Spaceship::ConnectAPI.get_beta_groups(filter: { id: group.id })).first || group
    rescue
      group
    end

  link =
    if refreshed.respond_to?(:public_link) then refreshed.public_link
    elsif refreshed.respond_to?(:[]) then refreshed["publicLink"]
    end
  if link.to_s.strip.empty?
    UI.message("Fishers public link enabled (URL appears in App Store Connect → TestFlight → Fishers)")
  else
    UI.success("Fishers TestFlight public link: #{link}")
  end
  link
end

def find_or_create_beta_group!(app:, name:, internal:)
  existing =
    Array(app.get_beta_groups(filter: { name: name })).find { |g| g.name == name } ||
    Array(app.get_beta_groups).find { |g| g.name == name }
  return existing if existing&.id

  UI.message("Creating #{internal ? 'internal' : 'external'} TestFlight group '#{name}'")
  if internal
    # Internal groups reject publicLink* attributes — post a minimal body.
    body = {
      data: {
        type: "betaGroups",
        attributes: {
          name: name,
          isInternalGroup: true,
          hasAccessToAllBuilds: true
        },
        relationships: {
          app: { data: { type: "apps", id: app.id } }
        }
      }
    }
    client = Spaceship::ConnectAPI.client
    UI.user_error!("Spaceship ConnectAPI client missing — token not set") unless client
    client.test_flight_request_client.post("v1/betaGroups", body)
  else
    Spaceship::ConnectAPI.create_beta_group(
      app_id: app.id,
      group_name: name,
      is_internal_group: false,
      public_link_enabled: true,
      public_link_limit: 10_000,
      public_link_limit_enabled: false
    )
  end

  group = Array(app.get_beta_groups(filter: { name: name })).find { |g| g.name == name } ||
          Array(app.get_beta_groups).find { |g| g.name == name }
  UI.user_error!("Could not create or load TestFlight group '#{name}'") unless group&.id
  group
end

def ensure_fishers_external_group!(app:)
  group = find_or_create_beta_group!(app: app, name: testflight_group_name, internal: false)
  ensure_fishers_public_link!(group: group)
  group
end

def ensure_fishers_internal_group!(app:)
  find_or_create_beta_group!(app: app, name: INTERNAL_TESTFLIGHT_GROUP, internal: true)
end

# Ensure external group "Fishers" exists and each tester gets a FRESH install invite.
def ensure_fishers_group_testers!(api_key:)
  spaceship_token_from!(api_key)
  app = fishers_app!
  group = ensure_fishers_external_group!(app: app)

  testflight_tester_emails.each do |email|
    invite_tester_to_fishers!(app: app, group: group, email: email)
  end

  UI.success(
    "If no invite email arrives within ~15 minutes, open on iPhone: #{FISHERS_PUBLIC_LINK} " \
    "(TestFlight app must be installed). ASC team members can also open the TestFlight app directly."
  )
  group.name
end

def ensure_testflight_testers!(api_key:)
  ensure_fishers_group_testers!(api_key: api_key)
end

def ensure_fishers_internal_testers!(api_key:)
  ensure_fishers_group_testers!(api_key: api_key)
end

def beta_app_review_info_hash
  {
    contact_email: ENV.fetch("TESTFLIGHT_CONTACT_EMAIL", testflight_tester_emails.first),
    contact_first_name: ENV.fetch("TESTFLIGHT_CONTACT_FIRST_NAME", "Balinder"),
    contact_last_name: ENV.fetch("TESTFLIGHT_CONTACT_LAST_NAME", "Walia"),
    contact_phone: ENV.fetch("TESTFLIGHT_CONTACT_PHONE", "+447911123456"),
    demo_account_required: false,
    notes: ENV.fetch(
      "TESTFLIGHT_REVIEW_NOTES",
      "QA build for Fishers TestFlight testers. No special demo account required."
    )
  }
end

# Internal TestFlight (App Store Connect Users) does not need Beta App Review —
# ASC team members can install as soon as processing finishes. External groups
# stay "No Builds Available" until Apple approves Beta App Review.
def spaceship_token_from!(api_key)
  require "spaceship"
  token_args = {
    key_id: api_key[:key_id] || api_key["key_id"],
    issuer_id: api_key[:issuer_id] || api_key["issuer_id"],
    duration: 500,
    in_house: false
  }
  if api_key[:key] || api_key["key"]
    token_args[:key] = api_key[:key] || api_key["key"]
  else
    token_args[:filepath] = api_key[:key_filepath] || api_key[:filepath] || ENV["ASC_KEY_FILEPATH"]
  end
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**token_args)
end

def latest_valid_build(app:)
  Array(app.get_builds(filter: { processingState: "VALID" }, sort: "-uploadedDate")).first
rescue => e
  UI.message("app.get_builds failed (#{e.message}); trying ConnectAPI.get_builds")
  Array(
    Spaceship::ConnectAPI.get_builds(
      filter: { app: app.id, processingState: "VALID" },
      sort: "-uploadedDate",
      limit: 5,
      includes: nil
    )
  ).first
end

def attach_build_to_groups!(build:, group_ids:, label:)
  return if group_ids.empty?

  version = build.respond_to?(:version) ? build.version : "?"
  begin
    Spaceship::ConnectAPI.add_beta_groups_to_build(
      build_id: build.id,
      beta_group_ids: group_ids
    )
    UI.success("Build #{version} attached to #{label}")
  rescue => e
    msg = e.message.to_s
    if msg =~ /already|exists|conflict/i
      UI.message("Build #{version} already on #{label} — ok")
    else
      UI.important("Attach build to #{label} failed: #{msg}")
    end
  end
end

# Apple requires filter[build] here — filtering by app is rejected — so ask
# about the app's recent builds, which is where any live review will be.
def beta_app_review_in_progress?(app:)
  # One page, not app.get_builds — that follows every page of every build. No
  # includes: fastlane's default asks for betaBuildMetrics, which Apple rejects.
  recent = Spaceship::ConnectAPI.get_builds(filter: { app: app.id }, includes: nil, sort: "-uploadedDate", limit: 20)
  build_ids = Array(recent.to_models).map(&:id).compact
  return false if build_ids.empty?

  pages = Spaceship::ConnectAPI.get_beta_app_review_submissions(filter: { build: build_ids.join(",") }).all_pages
  Array(pages).flat_map(&:to_models).any? do |sub|
    sub.respond_to?(:beta_review_state) && sub.beta_review_state.to_s =~ /WAITING_FOR_REVIEW|IN_REVIEW/
  end
rescue => e
  UI.message("Could not list Beta App Review submissions (#{e.message})")
  false
end

def submit_fishers_external_review_if_needed!(key:, group:)
  notes = ENV.fetch("TESTFLIGHT_CHANGELOG", "Fishers TestFlight build — please install and smoke-test.")
  beta_desc = ENV.fetch(
    "TESTFLIGHT_BETA_DESCRIPTION",
    "Fishers is a club sports app for fixtures, live cricket scoring, chat, and team selection."
  )

  # Leave a review that is already under way alone. Cancelling it on every
  # merge meant no build ever finished review, so external testers never had
  # an installable build. Internal testers do not wait on this at all.
  if beta_app_review_in_progress?(app: fishers_app!)
    UI.message("A build is already in Beta App Review — leaving it to finish")
    return false
  end

  upload_to_testflight(
    api_key: key,
    distribute_only: true,
    app_identifier: APP_ID,
    app_platform: "ios",
    skip_waiting_for_build_processing: false,
    distribute_external: true,
    submit_beta_review: true,
    notify_external_testers: true,
    groups: [group.name],
    changelog: notes,
    beta_app_description: beta_desc,
    beta_app_feedback_email: testflight_tester_emails.first,
    demo_account_required: false,
    uses_non_exempt_encryption: false,
    reject_build_waiting_for_review: false,
    beta_app_review_info: beta_app_review_info_hash,
    localized_app_info: {
      "en-GB": {
        feedback_email: testflight_tester_emails.first,
        description: beta_desc
      }
    }
  )
  UI.success("Submitted latest build to Fishers for Beta App Review + notify")
  true
rescue => e
  msg = e.message.to_s
  if msg =~ /another.*review|already.*review|waiting for review|Beta App Review/i
    UI.important(
      "Still blocked by Beta App Review: #{msg}. " \
      "Cancel Waiting for Review manually in App Store Connect → TestFlight → the build, " \
      "then re-run invite_testers / ready_testers."
    )
  else
    UI.important("External review submit skipped: #{msg}")
  end
  false
end

def distribute_latest_build_to_testflight_groups!(external_group: nil)
  app = fishers_app!
  build = latest_valid_build(app: app)
  unless build&.id
    UI.important("No processed TestFlight build found to attach to groups")
    return nil
  end

  internal_group = ensure_fishers_internal_group!(app: app)
  if internal_group.has_access_to_all_builds
    UI.message("Build on internal '#{internal_group.name}' automatically (group has every build)")
  else
    attach_build_to_groups!(build: build, group_ids: [internal_group.id], label: "internal '#{internal_group.name}'")
  end

  if external_group&.id
    attach_build_to_groups!(
      build: build,
      group_ids: [external_group.id],
      label: "external '#{external_group.name}' (install after Beta App Review)"
    )
  end

  build
rescue => e
  UI.important("distribute_latest_build_to_testflight_groups! skipped: #{e.message}")
  nil
end

def emit_github(file_env_var, line)
  path = ENV[file_env_var]
  File.write(path, "#{line}\n", mode: "a") if path && !path.empty?
end

def ipa_output_dir
  File.expand_path("../build", __dir__)
end

def ipa_output_path
  File.join(ipa_output_dir, "Fishers.ipa")
end

def write_export_options(path, app_profile)
  File.write(path, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
    \t<key>method</key>
    \t<string>app-store-connect</string>
    \t<key>teamID</key>
    \t<string>#{team_id}</string>
    \t<key>signingStyle</key>
    \t<string>manual</string>
    \t<key>uploadSymbols</key>
    \t<true/>
    \t<key>compileBitcode</key>
    \t<false/>
    \t<key>stripSwiftSymbols</key>
    \t<true/>
    \t<key>manageAppVersionAndBuildNumber</key>
    \t<false/>
    \t<key>provisioningProfiles</key>
    \t<dict>
    \t\t<key>#{APP_ID}</key>
    \t\t<string>#{app_profile}</string>
    \t</dict>
    </dict>
    </plist>
  PLIST
end

platform :ios do
  desc "Generate project, build for Simulator, and run unit tests"
  lane :test do
    generate_xcode_project!
    run_tests(
      project: "Fishers.xcodeproj",
      scheme: "Fishers",
      devices: ["iPhone 17"],
      clean: true
    )
  end

  desc "Print next TestFlight build number for VERSION_NAME to GITHUB_OUTPUT"
  lane :ci_build_number do
    version = ENV.fetch("VERSION_NAME")
    latest = latest_testflight_build_number(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      version: version,
      initial_build_number: 0
    )
    nxt = latest.to_i + 1
    UI.message("Latest TestFlight build for #{version} is #{latest}; next is #{nxt}")
    emit_github("GITHUB_OUTPUT", "build_number=#{nxt}")
  end

  desc "Provision code signing from the ASC API key into a persistent keychain"
  lane :prepare_signing do
    generate_xcode_project!

    api_key = asc_api_key
    kc_path = ENV.fetch("BUILD_KEYCHAIN_PATH")
    kc_pass = ENV.fetch("BUILD_KEYCHAIN_PASSWORD")
    tmp_dir = ENV["RUNNER_TEMP"] || Dir.pwd

    if File.exist?(kc_path)
      unlock_keychain(path: kc_path, password: kc_pass, set_default: false)
    else
      create_keychain(
        path: kc_path,
        password: kc_pass,
        default_keychain: false,
        unlock: true,
        timeout: 3600,
        add_to_search_list: true
      )
    end
    sh("security", "list-keychains", "-d", "user", "-s", kc_path,
       File.expand_path("~/Library/Keychains/login.keychain-db"))
    sh("security", "set-keychain-settings", kc_path)

    cert(
      api_key: api_key,
      keychain_path: kc_path,
      keychain_password: kc_pass,
      output_path: tmp_dir
    )

    ensure_sign_in_with_apple_capability!(api_key)
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_ID,
      readonly: false,
      force: true
    )
    app_profile_name = lane_context[SharedValues::SIGH_NAME]
    app_profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    emit_github("GITHUB_ENV", "INSTALLED_PROFILE_PATH=#{app_profile_path}") if app_profile_path

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Fishers.xcodeproj",
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: app_profile_name,
      bundle_identifier: APP_ID,
      targets: ["Fishers"]
    )

    out = ENV.fetch("EXPORT_OPTIONS_PLIST", File.join(tmp_dir, "ExportOptions.plist"))
    write_export_options(out, app_profile_name)
    UI.success("Signing ready — ExportOptions at #{out}")
  end

  desc "Archive and export a signed App Store IPA"
  lane :build_ipa do
    if ENV["VERSION_NAME"] && !ENV["VERSION_NAME"].empty?
      increment_version_number(
        version_number: ENV["VERSION_NAME"],
        xcodeproj: "Fishers.xcodeproj"
      )
    end
    increment_build_number(
      build_number: ENV.fetch("BUILD_NUMBER"),
      xcodeproj: "Fishers.xcodeproj"
    )

    export_plist = ENV.fetch("EXPORT_OPTIONS_PLIST")
    build_app(
      project: "Fishers.xcodeproj",
      scheme: "Fishers",
      export_method: "app-store",
      export_options: export_plist,
      output_directory: ipa_output_dir,
      output_name: "Fishers.ipa",
      clean: true
    )
  end

  desc "Invite / resend Fishers TestFlight INSTALL emails (no IPA upload)"
  lane :invite_testers do
    key = asc_api_key
    spaceship_token_from!(key)
    app = fishers_app!
    external_group = ensure_fishers_external_group!(app: app)

    # Attach build + clear stuck review FIRST — Apple refuses invites with
    # "tester has no installable build" until Fishers has a distributed build.
    distribute_latest_build_to_testflight_groups!(external_group: external_group)
    submit_fishers_external_review_if_needed!(key: key, group: external_group)

    states = ensure_internal_testers!(app: app)
    # Anyone not yet on the team also gets the external group (after review).
    states.reject { |_, state| state == :member }.each_key do |email|
      invite_tester_to_fishers!(app: app, group: external_group, email: email)
    end
    report_tester_states(states)

    UI.success(
      "Requested TestFlight INSTALL invites for #{testflight_tester_emails.join(', ')}. " \
      "Subject: \"You're invited to test Fishers Sport\" — NOT processing-complete. " \
      "Backup: #{FISHERS_PUBLIC_LINK}"
    )
  end

  desc "Re-invite Fishers testers and re-distribute the latest processed build"
  lane :ready_testers do
    key = asc_api_key
    spaceship_token_from!(key)
    app = fishers_app!
    external_group = ensure_fishers_external_group!(app: app)
    distribute_latest_build_to_testflight_groups!(external_group: external_group)
    submit_fishers_external_review_if_needed!(key: key, group: external_group)
    states = ensure_internal_testers!(app: app)
    # Anyone not yet on the team also gets the external group (after review).
    states.reject { |_, state| state == :member }.each_key do |email|
      invite_tester_to_fishers!(app: app, group: external_group, email: email)
    end
    report_tester_states(states)
    UI.success("Fishers updated for #{testflight_tester_emails.join(', ')} — backup link #{FISHERS_PUBLIC_LINK}")
  end

  desc "Upload IPA to TestFlight Fishers group, invite + notify testers"
  lane :beta do
    ipa = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] || ipa_output_path
    UI.user_error!("No IPA at #{ipa}") unless File.exist?(ipa)

    key = asc_api_key

    # 1) Upload + wait for processing only (no external review inside pilot yet).
    upload_to_testflight(
      api_key: key,
      ipa: ipa,
      app_identifier: APP_ID,
      app_platform: "ios",
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      submit_beta_review: false,
      notify_external_testers: false,
      demo_account_required: false,
      uses_non_exempt_encryption: false
    )

    spaceship_token_from!(key)
    app = fishers_app!
    external_group = ensure_fishers_external_group!(app: app)

    # 2) Attach to internal Fishers Team (ASC install now) + external Fishers.
    distribute_latest_build_to_testflight_groups!(external_group: external_group)

    # 3) Cancel stuck Waiting for Review and submit latest — required before
    # Apple will send TestFlight install invite emails.
    submit_fishers_external_review_if_needed!(key: key, group: external_group)

    # 4) Internal testers (ASC team members) install now; others via external.
    states = ensure_internal_testers!(app: app)
    # Anyone not yet on the team also gets the external group (after review).
    states.reject { |_, state| state == :member }.each_key do |email|
      invite_tester_to_fishers!(app: app, group: external_group, email: email)
    end
    report_tester_states(states)

    UI.success(
      "Build uploaded. INSTALL invites requested for: #{testflight_tester_emails.join(', ')}. " \
      "Subject: \"You're invited to test Fishers Sport\" (ignore processing-complete mail). " \
      "ASC team: open TestFlight app. Everyone else: #{FISHERS_PUBLIC_LINK} if email missing."
    )
  end

  desc "Submit the latest build for App Store review (manual release gate)"
  lane :release do
    key = asc_api_key
    ipa = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] || ipa_output_path

    upload_to_testflight(
      api_key: key,
      ipa: ipa,
      app_identifier: APP_ID,
      app_platform: "ios",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      submit_beta_review: false
    )

    deliver(
      api_key: key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end
end
