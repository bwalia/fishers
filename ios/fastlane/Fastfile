# Fastfile — Fishers native iOS release (GitHub Actions + Vault + fastlane).
#
# CI signs with an App Store Connect API key. Secrets come from GitHub Actions
# or Vault via ci/load-ios-vault-secrets.sh, then:
#   ci_build_number → prepare_signing → build_ipa → beta (TestFlight)
# See .github/workflows/ios_release.yml and docs/IOS_RELEASE.md.

default_platform(:ios)

APP_ID = "com.fishers.app".freeze

# External TestFlight group + emails that should receive builds/invites.
# Override with TESTFLIGHT_GROUP / TESTFLIGHT_TESTERS (comma-separated).
DEFAULT_TESTFLIGHT_GROUP = "Fishers".freeze
DEFAULT_TESTFLIGHT_TESTERS = [
  "balindersinghwalia@icloud.com",
  "harchran001@gmail.com"
].freeze

def team_id
  ENV.fetch("APPLE_TEAM_ID") do
    UI.user_error!("APPLE_TEAM_ID is not set — add it to WSLVault kv/fishers/ios or GitHub secrets")
  end
end

def asc_api_key
  # duration 500 avoids a known Spaceship JWT skew issue where duration:1200
  # (default max) is rejected by App Store Connect as an invalid bearer token.
  # See fastlane/fastlane#29468 / #21109.
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID").to_s.strip,
    issuer_id: ENV.fetch("ASC_ISSUER_ID").to_s.strip,
    key_filepath: ENV.fetch("ASC_KEY_FILEPATH").to_s.strip,
    duration: 500,
    in_house: false
  )
end

def testflight_group_name
  ENV.fetch("TESTFLIGHT_GROUP", DEFAULT_TESTFLIGHT_GROUP).to_s.strip
end

def testflight_tester_emails
  raw = ENV["TESTFLIGHT_TESTERS"].to_s.strip
  list = if raw.empty?
           DEFAULT_TESTFLIGHT_TESTERS
         else
           raw.split(/[,\s]+/).map(&:strip).reject(&:empty?)
         end
  list.map(&:downcase).uniq
end

# Ensure the external beta group exists and contains the invite emails so
# upload_to_testflight can notify them. Apple emails the invite when a tester
# is first added; later builds notify via notify_external_testers.
def ensure_testflight_testers!(api_key:)
  require "spaceship"

  token_args = {
    key_id: api_key[:key_id] || api_key["key_id"],
    issuer_id: api_key[:issuer_id] || api_key["issuer_id"],
    duration: 500,
    in_house: false
  }
  if api_key[:key] || api_key["key"]
    token_args[:key] = api_key[:key] || api_key["key"]
  else
    token_args[:filepath] = api_key[:key_filepath] || api_key[:filepath] || ENV["ASC_KEY_FILEPATH"]
  end
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**token_args)

  app = Spaceship::ConnectAPI::App.find(APP_ID)
  UI.user_error!("App Store Connect app '#{APP_ID}' not found — create it first") unless app

  group_name = testflight_group_name

  find_group = lambda do
    Array(app.get_beta_groups(filter: { name: group_name })).find { |g| g.name == group_name }
  end

  group = find_group.call
  unless group
    UI.message("Creating TestFlight group '#{group_name}'")
    created = Spaceship::ConnectAPI.create_beta_group(
      app_id: app.id,
      group_name: group_name,
      is_internal_group: false,
      public_link_enabled: false,
      public_link_limit: 10_000,
      public_link_limit_enabled: false
    )
    # Some Spaceship versions return a Response, not a BetaGroup model.
    group = created.respond_to?(:id) && created.id ? created : find_group.call
    UI.user_error!("Could not create or load TestFlight group '#{group_name}'") unless group&.id
  end

  testflight_tester_emails.each do |email|
    UI.message("Ensuring TestFlight tester #{email} is in group '#{group_name}'")
    begin
      if group.respond_to?(:add_beta_testers)
        group.add_beta_testers(
          attributes: [{ email: email, firstName: email.split("@").first, lastName: "Tester" }]
        )
      else
        Spaceship::ConnectAPI.post_beta_tester_to_group(
          group_id: group.id,
          email: email,
          first_name: email.split("@").first,
          last_name: "Tester"
        )
      end
    rescue => e
      UI.important("Invite #{email}: #{e.message} — continuing")
    end
  end

  group_name
end

def emit_github(file_env_var, line)
  path = ENV[file_env_var]
  File.write(path, "#{line}\n", mode: "a") if path && !path.empty?
end

def ipa_output_dir
  File.expand_path("../build", __dir__)
end

def ipa_output_path
  File.join(ipa_output_dir, "Fishers.ipa")
end

def write_export_options(path, app_profile)
  File.write(path, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
    \t<key>method</key>
    \t<string>app-store-connect</string>
    \t<key>teamID</key>
    \t<string>#{team_id}</string>
    \t<key>signingStyle</key>
    \t<string>manual</string>
    \t<key>uploadSymbols</key>
    \t<true/>
    \t<key>compileBitcode</key>
    \t<false/>
    \t<key>stripSwiftSymbols</key>
    \t<true/>
    \t<key>manageAppVersionAndBuildNumber</key>
    \t<false/>
    \t<key>provisioningProfiles</key>
    \t<dict>
    \t\t<key>#{APP_ID}</key>
    \t\t<string>#{app_profile}</string>
    \t</dict>
    </dict>
    </plist>
  PLIST
end

platform :ios do
  desc "Generate project, build for Simulator, and run unit tests"
  lane :test do
    sh("xcodegen", "generate", "--spec", "../project.yml")
    run_tests(
      project: "Fishers.xcodeproj",
      scheme: "Fishers",
      devices: ["iPhone 17"],
      clean: true
    )
  end

  desc "Print next TestFlight build number for VERSION_NAME to GITHUB_OUTPUT"
  lane :ci_build_number do
    version = ENV.fetch("VERSION_NAME")
    latest = latest_testflight_build_number(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      version: version,
      initial_build_number: 0
    )
    nxt = latest.to_i + 1
    UI.message("Latest TestFlight build for #{version} is #{latest}; next is #{nxt}")
    emit_github("GITHUB_OUTPUT", "build_number=#{nxt}")
  end

  desc "Provision code signing from the ASC API key into a persistent keychain"
  lane :prepare_signing do
    sh("xcodegen", "generate", "--spec", "../project.yml")

    api_key = asc_api_key
    kc_path = ENV.fetch("BUILD_KEYCHAIN_PATH")
    kc_pass = ENV.fetch("BUILD_KEYCHAIN_PASSWORD")
    tmp_dir = ENV["RUNNER_TEMP"] || Dir.pwd

    if File.exist?(kc_path)
      unlock_keychain(path: kc_path, password: kc_pass, set_default: false)
    else
      create_keychain(
        path: kc_path,
        password: kc_pass,
        default_keychain: false,
        unlock: true,
        timeout: 3600,
        add_to_search_list: true
      )
    end
    sh("security", "list-keychains", "-d", "user", "-s", kc_path,
       File.expand_path("~/Library/Keychains/login.keychain-db"))
    sh("security", "set-keychain-settings", kc_path)

    cert(
      api_key: api_key,
      keychain_path: kc_path,
      keychain_password: kc_pass,
      output_path: tmp_dir
    )

    get_provisioning_profile(api_key: api_key, app_identifier: APP_ID, readonly: false)
    app_profile_name = lane_context[SharedValues::SIGH_NAME]
    app_profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    emit_github("GITHUB_ENV", "INSTALLED_PROFILE_PATH=#{app_profile_path}") if app_profile_path

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Fishers.xcodeproj",
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: app_profile_name,
      bundle_identifier: APP_ID,
      targets: ["Fishers"]
    )

    out = ENV.fetch("EXPORT_OPTIONS_PLIST", File.join(tmp_dir, "ExportOptions.plist"))
    write_export_options(out, app_profile_name)
    UI.success("Signing ready — ExportOptions at #{out}")
  end

  desc "Archive and export a signed App Store IPA"
  lane :build_ipa do
    if ENV["VERSION_NAME"] && !ENV["VERSION_NAME"].empty?
      increment_version_number(
        version_number: ENV["VERSION_NAME"],
        xcodeproj: "Fishers.xcodeproj"
      )
    end
    increment_build_number(
      build_number: ENV.fetch("BUILD_NUMBER"),
      xcodeproj: "Fishers.xcodeproj"
    )

    export_plist = ENV.fetch("EXPORT_OPTIONS_PLIST")
    build_app(
      project: "Fishers.xcodeproj",
      scheme: "Fishers",
      export_method: "app-store",
      export_options: export_plist,
      output_directory: ipa_output_dir,
      output_name: "Fishers.ipa",
      clean: true
    )
  end

  desc "Invite/ensure TestFlight testers without uploading a new IPA"
  lane :invite_testers do
    ensure_testflight_testers!(api_key: asc_api_key)
    UI.success(
      "Testers ready: #{testflight_tester_emails.join(', ')} " \
      "(group '#{testflight_group_name}'). " \
      "If they still have no email, open App Store Connect → TestFlight → " \
      "the Fishers group → Resend invite."
    )
  end

  desc "Upload the built IPA to TestFlight and notify Fishers QA testers"
  lane :beta do
    ipa = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] || ipa_output_path
    UI.user_error!("No IPA at #{ipa}") unless File.exist?(ipa)

    key = asc_api_key
    group = ensure_testflight_testers!(api_key: key)
    notes = ENV.fetch(
      "TESTFLIGHT_CHANGELOG",
      "Fishers TestFlight build — please install and smoke-test."
    )

    upload_to_testflight(
      api_key: key,
      ipa: ipa,
      skip_waiting_for_build_processing: false,
      distribute_external: true,
      groups: [group],
      notify_external_testers: true,
      changelog: notes,
      beta_app_description: ENV.fetch(
        "TESTFLIGHT_BETA_DESCRIPTION",
        "Fishers is a club sports app for fixtures, live cricket scoring, chat, and team selection."
      ),
      beta_app_feedback_email: testflight_tester_emails.first,
      demo_account_required: false,
      uses_non_exempt_encryption: false,
      reject_build_waiting_for_review: false
    )
  end

  desc "Submit the latest build for App Store review (manual release gate)"
  lane :release do
    key = asc_api_key
    ipa = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] || ipa_output_path

    upload_to_testflight(
      api_key: key,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )

    deliver(
      api_key: key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end
end
