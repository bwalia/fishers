# Fastfile — Fishers native iOS release (GitHub Actions + Vault + fastlane).
#
# CI signs with an App Store Connect API key. Secrets come from GitHub Actions
# or Vault via ci/load-ios-vault-secrets.sh, then:
#   ci_build_number → prepare_signing → build_ipa → beta (TestFlight)
# See .github/workflows/ios_release.yml and docs/IOS_RELEASE.md.

default_platform(:ios)

APP_ID = "com.fishers.app".freeze

# External TestFlight group + emails that should receive builds/invites.
# Override with TESTFLIGHT_GROUP / TESTFLIGHT_TESTERS (comma-separated).
# Permanent policy: Internal Testing only (no Apple Beta App Review).
DEFAULT_TESTFLIGHT_GROUP = "Fishers Internal".freeze
DEFAULT_TESTFLIGHT_TESTERS = [
  "balindersinghwalia@icloud.com",
  "harchran001@gmail.com"
].freeze

def team_id
  ENV.fetch("APPLE_TEAM_ID") do
    UI.user_error!("APPLE_TEAM_ID is not set — add it to WSLVault kv/fishers/ios or GitHub secrets")
  end
end

def asc_api_key
  # duration 500 avoids a known Spaceship JWT skew issue where duration:1200
  # (default max) is rejected by App Store Connect as an invalid bearer token.
  # See fastlane/fastlane#29468 / #21109.
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID").to_s.strip,
    issuer_id: ENV.fetch("ASC_ISSUER_ID").to_s.strip,
    key_filepath: ENV.fetch("ASC_KEY_FILEPATH").to_s.strip,
    duration: 500,
    in_house: false
  )
end

def testflight_group_name
  ENV.fetch("TESTFLIGHT_GROUP", DEFAULT_TESTFLIGHT_GROUP).to_s.strip
end

def testflight_tester_emails
  raw = ENV["TESTFLIGHT_TESTERS"].to_s.strip
  list = if raw.empty?
           DEFAULT_TESTFLIGHT_TESTERS
         else
           raw.split(/[,\s]+/).map(&:strip).reject(&:empty?)
         end
  list.map(&:downcase).uniq
end

# Invite Fishers testers as App Store Connect users and ensure the internal
# TestFlight group exists. Internal Testing never needs Beta App Review —
# Apple emails an ASC seat invite once; every later main merge just ships a build.
def ensure_fishers_internal_testers!(api_key:)
  spaceship_token_from!(api_key)

  app = Spaceship::ConnectAPI::App.find(APP_ID)
  UI.user_error!("App Store Connect app '#{APP_ID}' not found — create it first") unless app

  group_name = testflight_group_name

  find_group = lambda do
    Array(app.get_beta_groups).find do |g|
      g.name == group_name && (
        begin
          g.respond_to?(:is_internal_group) ? g.is_internal_group : true
        rescue
          true
        end
      )
    end || Array(app.get_beta_groups(filter: { name: group_name })).find { |g| g.name == group_name }
  end

  group = find_group.call
  unless group
    UI.message("Creating internal TestFlight group '#{group_name}' (auto-distribute, no review)")
    created = Spaceship::ConnectAPI.create_beta_group(
      app_id: app.id,
      group_name: group_name,
      is_internal_group: true,
      has_access_to_all_builds: true
    )
    group = created.respond_to?(:id) && created.id ? created : find_group.call
    UI.user_error!("Could not create or load internal group '#{group_name}'") unless group&.id
  end

  # One-time ASC seat invites — required for Internal Testing (no Beta App Review).
  testflight_tester_emails.each do |email|
    UI.message("Ensuring App Store Connect access for #{email}")
    begin
      existing_user = begin
        Spaceship::ConnectAPI::User.all(filter: { email: email }).first
      rescue
        nil
      end
      if existing_user
        UI.message("#{email} already an App Store Connect user — ok")
        next
      end

      pending = begin
        inv = Spaceship::ConnectAPI::UserInvitation.find(email: email)
        inv.respond_to?(:each) ? Array(inv).first : inv
      rescue
        nil
      end
      if pending
        UI.message("#{email} already has a pending ASC invite — ok")
        next
      end

      first = email.split("@").first.to_s
      Spaceship::ConnectAPI::UserInvitation.create(
        email: email,
        first_name: first[0, 30],
        last_name: "Tester",
        roles: ["MARKETING"],
        provisioning_allowed: false,
        all_apps_visible: false,
        visible_app_ids: [app.id]
      )
      UI.success("Sent App Store Connect invite to #{email} (accept once, then TestFlight installs forever)")
    rescue => e
      msg = e.message.to_s
      if msg =~ /already|exists|conflict|duplicate/i
        UI.message("#{email}: #{msg} — ok")
      else
        UI.important(
          "ASC invite #{email}: #{msg} — if they already have access, ignore. " \
          "Otherwise invite them under Users and Access."
        )
      end
    end
  end

  group_name
end

# Back-compat alias used by invite_testers lane.
def ensure_testflight_testers!(api_key:)
  ensure_fishers_internal_testers!(api_key: api_key)
end

# Internal TestFlight (App Store Connect Users) does not need Beta App Review —
# ASC team members can install as soon as processing finishes. External groups
# stay "No Builds Available" until Apple approves Beta App Review.
def spaceship_token_from!(api_key)
  require "spaceship"
  token_args = {
    key_id: api_key[:key_id] || api_key["key_id"],
    issuer_id: api_key[:issuer_id] || api_key["issuer_id"],
    duration: 500,
    in_house: false
  }
  if api_key[:key] || api_key["key"]
    token_args[:key] = api_key[:key] || api_key["key"]
  else
    token_args[:filepath] = api_key[:key_filepath] || api_key[:filepath] || ENV["ASC_KEY_FILEPATH"]
  end
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**token_args)
end

def attach_latest_build_to_internal!
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  UI.user_error!("App Store Connect app '#{APP_ID}' not found") unless app

  # Prefer App#get_builds — ConnectAPI.get_builds can request removed includes
  # (betaBuildMetrics) and 400 on current ASC API.
  builds =
    begin
      Array(app.get_builds(filter: { processingState: "VALID" }, sort: "-uploadedDate"))
    rescue => e
      UI.message("app.get_builds failed (#{e.message}); trying ConnectAPI.get_builds")
      begin
        Array(
          Spaceship::ConnectAPI.get_builds(
            filter: { app: app.id, processingState: "VALID" },
            sort: "-uploadedDate",
            limit: 5,
            includes: nil
          )
        )
      rescue => e2
        UI.important("Could not list builds for internal attach: #{e2.message}")
        return nil
      end
    end
  build = builds.first
  unless build&.id
    UI.important("No processed TestFlight build found to attach internally — pilot internal distribute may already have covered ASC users")
    return nil
  end

  version = build.respond_to?(:version) ? build.version : "?"
  UI.message("Attaching build #{version} (id=#{build.id}) to internal TestFlight groups")

  all_groups = Array(app.get_beta_groups)
  internal = all_groups.select do |g|
    begin
      if g.respond_to?(:is_internal_group)
        !!g.is_internal_group
      elsif g.respond_to?(:[])
        !!g["isInternalGroup"]
      else
        false
      end
    rescue
      false
    end
  end
  if internal.empty?
    internal = all_groups.select { |g| g.name.to_s =~ /App Store Connect Users/i }
  end
  if internal.empty?
    UI.message("Creating internal group 'Fishers Internal' (no Beta App Review)")
    created = Spaceship::ConnectAPI.create_beta_group(
      app_id: app.id,
      group_name: "Fishers Internal",
      is_internal_group: true,
      has_access_to_all_builds: true
    )
    internal = [created.respond_to?(:id) && created.id ? created : nil].compact
    internal = Array(app.get_beta_groups).select { |g| g.name == "Fishers Internal" } if internal.empty?
  end
  if internal.empty?
    UI.important("No internal TestFlight group available — skip attach")
    return nil
  end

  begin
    Spaceship::ConnectAPI.add_beta_groups_to_build(
      build_id: build.id,
      beta_group_ids: internal.map(&:id)
    )
    UI.success(
      "Build #{version} attached to internal: #{internal.map(&:name).join(', ')}. " \
      "App Store Connect users can install now in the TestFlight app (no review wait)."
    )
  rescue => e
    msg = e.message.to_s
    if msg =~ /already|exists|conflict/i
      UI.message("Build already on an internal group — ok")
    else
      UI.important("Internal attach failed: #{msg}")
    end
  end

  build
rescue => e
  UI.important("attach_latest_build_to_internal! skipped: #{e.message}")
  nil
end

def emit_github(file_env_var, line)
  path = ENV[file_env_var]
  File.write(path, "#{line}\n", mode: "a") if path && !path.empty?
end

def ipa_output_dir
  File.expand_path("../build", __dir__)
end

def ipa_output_path
  File.join(ipa_output_dir, "Fishers.ipa")
end

def write_export_options(path, app_profile)
  File.write(path, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
    \t<key>method</key>
    \t<string>app-store-connect</string>
    \t<key>teamID</key>
    \t<string>#{team_id}</string>
    \t<key>signingStyle</key>
    \t<string>manual</string>
    \t<key>uploadSymbols</key>
    \t<true/>
    \t<key>compileBitcode</key>
    \t<false/>
    \t<key>stripSwiftSymbols</key>
    \t<true/>
    \t<key>manageAppVersionAndBuildNumber</key>
    \t<false/>
    \t<key>provisioningProfiles</key>
    \t<dict>
    \t\t<key>#{APP_ID}</key>
    \t\t<string>#{app_profile}</string>
    \t</dict>
    </dict>
    </plist>
  PLIST
end

platform :ios do
  desc "Generate project, build for Simulator, and run unit tests"
  lane :test do
    sh("xcodegen", "generate", "--spec", "../project.yml")
    run_tests(
      project: "Fishers.xcodeproj",
      scheme: "Fishers",
      devices: ["iPhone 17"],
      clean: true
    )
  end

  desc "Print next TestFlight build number for VERSION_NAME to GITHUB_OUTPUT"
  lane :ci_build_number do
    version = ENV.fetch("VERSION_NAME")
    latest = latest_testflight_build_number(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      version: version,
      initial_build_number: 0
    )
    nxt = latest.to_i + 1
    UI.message("Latest TestFlight build for #{version} is #{latest}; next is #{nxt}")
    emit_github("GITHUB_OUTPUT", "build_number=#{nxt}")
  end

  desc "Provision code signing from the ASC API key into a persistent keychain"
  lane :prepare_signing do
    sh("xcodegen", "generate", "--spec", "../project.yml")

    api_key = asc_api_key
    kc_path = ENV.fetch("BUILD_KEYCHAIN_PATH")
    kc_pass = ENV.fetch("BUILD_KEYCHAIN_PASSWORD")
    tmp_dir = ENV["RUNNER_TEMP"] || Dir.pwd

    if File.exist?(kc_path)
      unlock_keychain(path: kc_path, password: kc_pass, set_default: false)
    else
      create_keychain(
        path: kc_path,
        password: kc_pass,
        default_keychain: false,
        unlock: true,
        timeout: 3600,
        add_to_search_list: true
      )
    end
    sh("security", "list-keychains", "-d", "user", "-s", kc_path,
       File.expand_path("~/Library/Keychains/login.keychain-db"))
    sh("security", "set-keychain-settings", kc_path)

    cert(
      api_key: api_key,
      keychain_path: kc_path,
      keychain_password: kc_pass,
      output_path: tmp_dir
    )

    get_provisioning_profile(api_key: api_key, app_identifier: APP_ID, readonly: false)
    app_profile_name = lane_context[SharedValues::SIGH_NAME]
    app_profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    emit_github("GITHUB_ENV", "INSTALLED_PROFILE_PATH=#{app_profile_path}") if app_profile_path

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Fishers.xcodeproj",
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: app_profile_name,
      bundle_identifier: APP_ID,
      targets: ["Fishers"]
    )

    out = ENV.fetch("EXPORT_OPTIONS_PLIST", File.join(tmp_dir, "ExportOptions.plist"))
    write_export_options(out, app_profile_name)
    UI.success("Signing ready — ExportOptions at #{out}")
  end

  desc "Archive and export a signed App Store IPA"
  lane :build_ipa do
    if ENV["VERSION_NAME"] && !ENV["VERSION_NAME"].empty?
      increment_version_number(
        version_number: ENV["VERSION_NAME"],
        xcodeproj: "Fishers.xcodeproj"
      )
    end
    increment_build_number(
      build_number: ENV.fetch("BUILD_NUMBER"),
      xcodeproj: "Fishers.xcodeproj"
    )

    export_plist = ENV.fetch("EXPORT_OPTIONS_PLIST")
    build_app(
      project: "Fishers.xcodeproj",
      scheme: "Fishers",
      export_method: "app-store",
      export_options: export_plist,
      output_directory: ipa_output_dir,
      output_name: "Fishers.ipa",
      clean: true
    )
  end

  desc "Invite/ensure Fishers TestFlight testers (ASC seats + internal group)"
  lane :invite_testers do
    group = ensure_fishers_internal_testers!(api_key: asc_api_key)
    UI.success(
      "Testers ready for '#{group}': #{testflight_tester_emails.join(', ')}. " \
      "They must accept the App Store Connect email once, then every main merge " \
      "appears in TestFlight Internal Testing with no Apple review."
    )
  end

  desc "Attach the latest processed build to internal testers so ASC users can install now"
  lane :ready_testers do
    key = asc_api_key
    ensure_fishers_internal_testers!(api_key: key)
    attach_latest_build_to_internal!
    UI.success(
      "Latest build attached to Internal Testing. Open TestFlight with an " \
      "App Store Connect Apple ID and install Fishers."
    )
  end

  desc "Upload IPA to TestFlight Internal Testing — auto-invite testers, never Beta App Review"
  lane :beta do
    ipa = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] || ipa_output_path
    UI.user_error!("No IPA at #{ipa}") unless File.exist?(ipa)

    key = asc_api_key
    group = ensure_fishers_internal_testers!(api_key: key)
    notes = ENV.fetch(
      "TESTFLIGHT_CHANGELOG",
      "Fishers TestFlight build — please install and smoke-test."
    )
    beta_desc = ENV.fetch(
      "TESTFLIGHT_BETA_DESCRIPTION",
      "Fishers is a club sports app for fixtures, live cricket scoring, chat, and team selection."
    )

    # Permanent policy on every main merge:
    # - Invite/ensure Fishers testers (ASC seats)
    # - Distribute to internal group only
    # - submit_beta_review: false (fastlane defaults to true and causes Waiting for Review)
    upload_to_testflight(
      api_key: key,
      ipa: ipa,
      app_identifier: APP_ID,
      app_platform: "ios",
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      notify_external_testers: false,
      submit_beta_review: false,
      groups: [group],
      changelog: notes,
      beta_app_description: beta_desc,
      beta_app_feedback_email: testflight_tester_emails.first,
      demo_account_required: false,
      uses_non_exempt_encryption: false,
      reject_build_waiting_for_review: false
    )

    attach_latest_build_to_internal!
    UI.success(
      "Shipped to '#{group}' with no Apple review. Testers: #{testflight_tester_emails.join(', ')}. " \
      "Open TestFlight (same Apple ID as the ASC invite) and Install Fishers."
    )
  end

  desc "Submit the latest build for App Store review (manual release gate)"
  lane :release do
    key = asc_api_key
    ipa = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] || ipa_output_path

    upload_to_testflight(
      api_key: key,
      ipa: ipa,
      app_identifier: APP_ID,
      app_platform: "ios",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      submit_beta_review: false
    )

    deliver(
      api_key: key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end
end
