# scripts/start.sh generates web/.env.local itself, with the port .env names.
# This file is for the cases it does not cover.

# The API's port, when the dashboard is started by hand rather than by
# scripts/start.sh. The browser derives the host from the page it loaded, so
# only the port is needed — a LAN address baked in here stops working the
# moment DHCP hands this machine a different one.
# NEXT_PUBLIC_API_PORT=7312

# A full base URL, for an API that is genuinely somewhere else — another
# machine, or a ring. Wins over the port above.
# NEXT_PUBLIC_API_BASE=https://int.fishers.cloud
