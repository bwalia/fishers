{
  "name": "fishers-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname :: -p ${WEB_PORT:-7311}",
    "build": "next build",
    "start": "next start --hostname :: -p ${WEB_PORT:-7311}",
    "lint": "eslint .",
    "brand": "node ../tools/brand/ensure-installed.mjs generate ${BRAND:-fishers} --web",
    "brand:check": "node ../tools/brand/ensure-installed.mjs check",
    "prebuild": "npm run brand",
    "predev": "npm run brand"
  },
  "dependencies": {
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "typescript": "^5.9.2"
  }
}
